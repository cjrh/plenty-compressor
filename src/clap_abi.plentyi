# Trusted CLAP 1.2.10 Linux GNU x86_64 ABI. Layouts checked by native tests.
# Host pointers are borrowed for the callback; no Plenty reference aliases them.
@thread_movable
pub opaque Pointer

@thread_safe
pub extern def read_Pointer(p: Pointer, offset: u64) -> Pointer = intrinsic "load"

@thread_safe
pub extern def write_Pointer(p: Pointer, offset: u64, value: Pointer) -> () = intrinsic "store"

@thread_safe
pub extern def read_u8(p: Pointer, offset: u64) -> u8 = intrinsic "load"

@thread_safe
pub extern def write_u8(p: Pointer, offset: u64, value: u8) -> () = intrinsic "store"

@thread_safe
pub extern def read_u16(p: Pointer, offset: u64) -> u16 = intrinsic "load"

@thread_safe
pub extern def write_u16(p: Pointer, offset: u64, value: u16) -> () = intrinsic "store"

@thread_safe
pub extern def read_i16(p: Pointer, offset: u64) -> i16 = intrinsic "load"

@thread_safe
pub extern def write_i16(p: Pointer, offset: u64, value: i16) -> () = intrinsic "store"

@thread_safe
pub extern def read_u32(p: Pointer, offset: u64) -> u32 = intrinsic "load"

@thread_safe
pub extern def write_u32(p: Pointer, offset: u64, value: u32) -> () = intrinsic "store"

@thread_safe
pub extern def read_i32(p: Pointer, offset: u64) -> i32 = intrinsic "load"

@thread_safe
pub extern def write_i32(p: Pointer, offset: u64, value: i32) -> () = intrinsic "store"

@thread_safe
pub extern def read_u64(p: Pointer, offset: u64) -> u64 = intrinsic "load"

@thread_safe
pub extern def write_u64(p: Pointer, offset: u64, value: u64) -> () = intrinsic "store"

@thread_safe
pub extern def read_f32(p: Pointer, offset: u64) -> f32 = intrinsic "load"

@thread_safe
pub extern def write_f32(p: Pointer, offset: u64, value: f32) -> () = intrinsic "store"

@thread_safe
pub extern def read_f64(p: Pointer, offset: u64) -> f64 = intrinsic "load"

@thread_safe
pub extern def write_f64(p: Pointer, offset: u64, value: f64) -> () = intrinsic "store"

@thread_safe
pub extern def offset(p: Pointer, offset: u64) -> Pointer = intrinsic "offset"

@thread_safe
pub extern def allocate(count: u64, size: u64) -> Pointer = "calloc"

@thread_safe
pub extern def free(p: Pointer) -> () = "free"

@thread_safe
pub extern def compare(a: Pointer, b: Pointer) -> i32 = "strcmp"

@thread_safe
pub extern def copy_bytes(to: Pointer, source: Pointer, size: u64) -> Pointer = "memcpy"

# GCC generic libatomic ABI: leading size, address, scalar buffer, memory order.
# Only aligned 8-byte slots, checked lock-free before publishing each instance.
@thread_safe
pub extern def atomic_read(size: u64, p: Pointer, output: &mut f64, order: i32) -> () = "__atomic_load"

@thread_safe
pub extern def atomic_write(size: u64, p: Pointer, value: &f64, order: i32) -> () = "__atomic_store"

@thread_safe
pub extern def lock_free(size: u64, p: Pointer) -> bool = "__atomic_is_lock_free"

# Function pointers come from resident host tables, with the exact CLAP
# signatures below. Invoke only during the corresponding host callback scope.
@host_callback
pub extern def event_count(function: Pointer, list: Pointer) -> u32 = function

@host_callback
pub extern def event_get(function: Pointer, list: Pointer, index: u32) -> Pointer = function

@host_callback
pub extern def host_extension(function: Pointer, host: Pointer, id: Pointer) -> Pointer = function

@host_callback
pub extern def rescan(function: Pointer, host: Pointer, flags: u32) -> () = function

@host_callback
pub extern def stream(function: Pointer, stream: Pointer, buffer: Pointer, size: u64) -> i64 = function

