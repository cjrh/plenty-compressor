pub extern def features() -> Pointer = object "pc_clap_features"(size=32, align=8):
    0: object = "pc_clap_effect"
    8: object = "pc_clap_compressor"
    16: object = "pc_clap_stereo"

@thread_safe
pub extern def descriptor() -> Pointer = object "pc_clap_descriptor"(size=88, align=8):
    0: u32 = 1
    4: u32 = 2
    8: u32 = 10
    16: object = "pc_clap_id"
    24: object = "pc_clap_name"
    32: object = "pc_clap_vendor"
    40: object = "pc_clap_url"
    48: object = "pc_clap_empty"
    56: object = "pc_clap_empty"
    64: object = "pc_clap_version"
    72: object = "pc_clap_description"
    80: object = "pc_clap_features"

