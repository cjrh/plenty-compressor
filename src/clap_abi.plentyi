    8: callback = "compressor_clap_load"

@thread_safe
pub extern def entry() -> Pointer = object "clap_entry"(size=40, align=8):
    0: u32 = 1
    4: u32 = 2
    8: u32 = 10
    16: callback = "compressor_clap_entry_init"
    24: callback = "compressor_clap_entry_deinit"
    32: callback = "compressor_clap_get_factory"

